# Used by `npm test`. Values already set in the environment (e.g. CI) take precedence.
# Every setting the tests rely on is pinned here, so a developer's own .env
# (which Prisma also reads) can never change test behaviour.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/secureaccess_test?schema=public"
PORT=4000
PUBLIC_URL=
TRUST_PROXY=1

JWT_SECRET="test-only-secret-not-for-production-0123456789abcdef"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
OIDC_PRIVATE_KEY=

BCRYPT_ROUNDS=4
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
TRUSTED_DEVICE_DAYS=30

RATE_LIMIT_ENABLED=false
ALLOWED_ORIGINS=*

AUDIT_LOG_READS=true
AUDIT_RETENTION_DAYS=90

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_ACCOUNTS=true
