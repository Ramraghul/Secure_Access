{
  "name": "secureaccess",
  "version": "3.0.0",
  "description": "Authentication, RBAC, MFA, audit trail and OpenID Connect provider — Express + TypeScript + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only --watch node_modules/.prisma/client/index.js src/server.ts",
    "build": "prisma generate && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:coverage": "jest --runInBand --coverage",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node --transpile-only src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "db:setup": "prisma migrate deploy && npm run seed",
    "studio": "prisma studio",
    "generate": "prisma generate",
    "keys:generate": "ts-node --transpile-only scripts/generate-keys.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/functions": "^3.9.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-device-detector": "^2.2.4",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "swagger-ui-dist": "^5.33.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
