{
  "name": "secureaccess",
  "version": "2.0.0",
  "description": "Enterprise Authentication & RBAC API",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "dev":     "ts-node-dev --respawn --transpile-only src/server.ts",
    "build":   "tsc",
    "start":   "node dist/server.js",
    "seed":    "ts-node prisma/seed.ts",
    "migrate": "prisma migrate dev",
    "studio":  "prisma studio",
    "generate":"prisma generate"
  },
  "dependencies": {
    "@prisma/client":          "^5.22.0",
    "bcryptjs":                "^2.4.3",
    "cors":                    "^2.8.5",
    "dotenv":                  "^16.4.1",
    "express":                 "^4.18.2",
    "express-rate-limit":      "^7.2.0",
    "helmet":                  "^7.1.0",
    "jsonwebtoken":            "^9.0.2",
    "morgan":                  "^1.10.0",
    "node-device-detector":    "^2.2.4",
    "qrcode":                  "^1.5.4",
    "speakeasy":               "^2.0.0",
    "swagger-jsdoc":           "^6.2.8",
    "swagger-ui-express":      "^5.0.1",
    "winston":                 "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod":                     "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs":           "^2.4.6",
    "@types/cors":               "^2.8.17",
    "@types/express":            "^4.17.21",
    "@types/jsonwebtoken":       "^9.0.5",
    "@types/morgan":             "^1.9.9",
    "@types/node":               "^20.11.5",
    "@types/qrcode":             "^1.5.5",
    "@types/speakeasy":          "^2.0.10",
    "@types/swagger-jsdoc":      "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma":                    "^5.22.0",
    "ts-node":                   "^10.9.2",
    "ts-node-dev":               "^2.0.0",
    "typescript":                "^5.3.3"
  }
}
