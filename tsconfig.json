{
  "compilerOptions": {
    "target":        "ES2022",
    "module":        "commonjs",
    "lib":           ["ES2022"],
    "outDir":        "./dist",
    "rootDir":       ".",
    "strict":        true,
    "esModuleInterop": true,
    "skipLibCheck":  true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types":         ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
