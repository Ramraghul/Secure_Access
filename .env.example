# ─────────────────────────────────────────────────────────────────
# SecureAccess configuration. Copy to .env and adjust.
# Required: DATABASE_URL, JWT_SECRET. Everything else has a default.
# ─────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL, no trailing slash. Used as the OpenID Connect issuer.
# Leave empty locally; set it in production, e.g. https://secureaccess.onrender.com
PUBLIC_URL=
# Number of reverse proxies in front of the app (Render/Vercel/Nginx = 1)
TRUST_PROXY=1
# Entries in Swagger's "Servers" dropdown (Local / Deployed)
# LOCAL_URL=http://localhost:4000
DEPLOYED_URL=https://secure-access-a8j6fkex8-ramraghuls-projects.vercel.app

# ── Database (PostgreSQL) ───────────────────────────────────────
# Local Docker (docker compose up -d db):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/secureaccess?schema=public"
# Neon / Supabase: paste their connection string and keep ?sslmode=require

# ── Tokens ──────────────────────────────────────────────────────
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# RSA private key for OpenID Connect tokens (PEM or base64-encoded PEM).
# Generate with: npm run keys:generate
# If empty, an ephemeral key is generated at startup (OIDC tokens break on restart).
OIDC_PRIVATE_KEY=

# ── Security ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Days a "remembered" device may skip the MFA code
TRUSTED_DEVICE_DAYS=30

# ── Rate limiting (per process) ─────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated origins, or * for any. Only matters for browser apps on other origins.
ALLOWED_ORIGINS=*

# ── Audit trail ─────────────────────────────────────────────────
# Set false to skip GET requests and save database space on free tiers
AUDIT_LOG_READS=true
AUDIT_RETENTION_DAYS=90

# ── Logging ─────────────────────────────────────────────────────
# LOG_LEVEL=info
# LOG_TO_FILE=false

# ── Seed (npm run seed) ─────────────────────────────────────────
# Admin account — ALWAYS set a strong private password in production
SEED_ADMIN_EMAIL=admin@secureaccess.dev
SEED_ADMIN_PASSWORD=
# Read-only demo accounts you can publish on your portfolio (protected from changes)
SEED_DEMO_ACCOUNTS=true
